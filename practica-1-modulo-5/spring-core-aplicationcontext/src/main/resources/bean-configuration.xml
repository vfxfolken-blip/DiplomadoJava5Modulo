<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuración XML de los beans del modelo (SISAHC-ENP5).
    Aquí se definen Edificio, Salon y Profesor (dgtic.modelo), y el enlace Salon -> Edificio.
    El bean Horario se configura con anotaciones (ver services.xml).
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- ===================== EDIFICIOS ===================== -->

    <!-- Inyección por constructor + setters -->
    <bean id="edificioA" class="dgtic.modelo.Edificio">
        <constructor-arg index="0" value="1"/>
        <constructor-arg index="1" value="A"/>
        <constructor-arg index="2" value="Edificio A"/>
        <property name="numNiveles" value="3"/>
        <property name="ubicacion" value="Zona norte del plantel"/>
        <property name="status" value="ACTIVO"/>
    </bean>

    <!-- Inyección solo por setters -->
    <bean id="edificioB" class="dgtic.modelo.Edificio">
        <property name="idEdificio" value="2"/>
        <property name="clave" value="B"/>
        <property name="nombre" value="Edificio B"/>
        <property name="numNiveles" value="2"/>
        <property name="ubicacion" value="Zona sur del plantel"/>
        <property name="status" value="ACTIVO"/>
    </bean>

    <!-- ===================== SALONES ===================== -->
    <!-- Enlace entre beans: cada Salon referencia a su Edificio con ref -->

    <bean id="salonA101" class="dgtic.modelo.Salon">
        <property name="idSalon" value="1"/>
        <property name="clave" value="A-101"/>
        <property name="edificio" ref="edificioA"/>
        <property name="nivel" value="1"/>
        <property name="capacidad" value="45"/>
        <property name="tipoAula" value="Aula teórica"/>
        <property name="estatus" value="DISPONIBLE"/>
    </bean>

    <bean id="salonB205" class="dgtic.modelo.Salon">
        <property name="idSalon" value="2"/>
        <property name="clave" value="B-205"/>
        <property name="edificio" ref="edificioB"/>
        <property name="nivel" value="2"/>
        <property name="capacidad" value="30"/>
        <property name="tipoAula" value="Laboratorio de cómputo"/>
        <property name="estatus" value="DISPONIBLE"/>
    </bean>

    <!-- ===================== PROFESORES ===================== -->

    <bean id="profesorMatematicas" class="dgtic.modelo.Profesor">
        <property name="idProfesor" value="1"/>
        <property name="numeroTrabajador" value="T-10234"/>
        <property name="nombreCompleto" value="María Elena Torres Ruiz"/>
        <property name="correoInstitucional" value="mtorres@enp.unam.mx"/>
        <property name="departamento" value="Matemáticas"/>
        <property name="cargaMaxima" value="30"/>
        <property name="status" value="ACTIVO"/>
    </bean>

    <bean id="profesorInformatica" class="dgtic.modelo.Profesor">
        <property name="idProfesor" value="2"/>
        <property name="numeroTrabajador" value="T-20871"/>
        <property name="nombreCompleto" value="Carlos Alberto Méndez Soto"/>
        <property name="correoInstitucional" value="cmendez@enp.unam.mx"/>
        <property name="departamento" value="Informática"/>
        <property name="cargaMaxima" value="25"/>
        <property name="status" value="ACTIVO"/>
    </bean>

    <bean id="profesorAmbrosio" class="dgtic.modelo.Profesor">
        <property name="idProfesor" value="3"/>
        <property name="numeroTrabajador" value="831508"/>
        <property name="nombreCompleto" value="José Antonio Ambrosio Pimentel"/>
        <property name="correoInstitucional" value="jose.ambrosio@enp.unam.mx"/>
        <property name="departamento" value="Informática"/>
        <property name="cargaMaxima" value="40"/>
        <property name="status" value="ACTIVO"/>
    </bean>

    <bean id="profesorHistoria" class="dgtic.modelo.Profesor">
        <property name="idProfesor" value="4"/>
        <property name="numeroTrabajador" value="T-40012"/>
        <property name="nombreCompleto" value="Roberto Salinas Vega"/>
        <property name="correoInstitucional" value="rsalinas@enp.unam.mx"/>
        <property name="departamento" value="Historia"/>
        <property name="cargaMaxima" value="30"/>
        <property name="status" value="ACTIVO"/>
    </bean>

    <bean id="profesorBiologia" class="dgtic.modelo.Profesor">
        <property name="idProfesor" value="5"/>
        <property name="numeroTrabajador" value="T-50231"/>
        <property name="nombreCompleto" value="Ana Laura Pérez Ríos"/>
        <property name="correoInstitucional" value="aperez@enp.unam.mx"/>
        <property name="departamento" value="Biología"/>
        <property name="cargaMaxima" value="32"/>
        <property name="status" value="ACTIVO"/>
    </bean>

    <bean id="profesorEFisica" class="dgtic.modelo.Profesor">
        <property name="idProfesor" value="6"/>
        <property name="numeroTrabajador" value="831510"/>
        <property name="nombreCompleto" value="Juan Carlos Ambrosio Pimentel"/>
        <property name="correoInstitucional" value="juan.ambrosio@enp.unam.mx"/>
        <property name="departamento" value="Educación Física"/>
        <property name="cargaMaxima" value="60"/>
        <property name="status" value="ACTIVO"/>
    </bean>

    <!-- Para agregar otro profesor: copia un bloque <bean> completo,
         cambia el id (no se puede repetir) y los valores.
         Los name de <property> deben ser los atributos de Profesor. -->

    <!-- Plantilla con scope prototype: cada getBean() devuelve un objeto nuevo -->
    <bean id="profesorNuevo" class="dgtic.modelo.Profesor" scope="prototype">
        <property name="departamento" value="Sin asignar"/>
        <property name="cargaMaxima" value="20"/>
        <property name="status" value="PENDIENTE"/>
    </bean>

</beans>
